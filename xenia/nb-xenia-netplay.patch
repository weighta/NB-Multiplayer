diff --git a/src/xenia/hid/nbremote/nbremote_input_driver.cc b/src/xenia/hid/nbremote/nbremote_input_driver.cc
new file mode 100644
index 0000000..e93da1b
--- /dev/null
+++ b/src/xenia/hid/nbremote/nbremote_input_driver.cc
@@ -0,0 +1,211 @@
+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * NB Studio remote gamepad (see nbremote_input_driver.h).                    *
+ * Released under the BSD license - see LICENSE in the root for more details. *
+ ******************************************************************************
+ */
+
+#include "xenia/hid/nbremote/nbremote_input_driver.h"
+
+#include <winsock2.h>
+#include <ws2tcpip.h>
+
+#include <cstring>
+
+#include "xenia/base/cvar.h"
+#include "xenia/base/logging.h"
+#include "xenia/ui/virtual_key.h"
+
+DEFINE_int32(nb_remote_input_port, 0,
+             "NB Studio remote gamepad: UDP port on 127.0.0.1 receiving "
+             "controller states for users 0-3 (0 = off).",
+             "HID");
+
+namespace xe {
+namespace hid {
+namespace nbremote {
+
+NbRemoteInputDriver::NbRemoteInputDriver(xe::ui::Window* window,
+                                         size_t window_z_order)
+    : InputDriver(window, window_z_order) {}
+
+NbRemoteInputDriver::~NbRemoteInputDriver() {
+  stop_ = true;
+  if (socket_ != ~uintptr_t(0)) closesocket(static_cast<SOCKET>(socket_));
+  if (thread_.joinable()) thread_.join();
+}
+
+X_STATUS NbRemoteInputDriver::Setup() {
+  if (cvars::nb_remote_input_port <= 0) return X_STATUS_UNSUCCESSFUL;
+  WSADATA wsa;
+  WSAStartup(MAKEWORD(2, 2), &wsa);
+  SOCKET s = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+  if (s == INVALID_SOCKET) return X_STATUS_UNSUCCESSFUL;
+  sockaddr_in addr{};
+  addr.sin_family = AF_INET;
+  addr.sin_port = htons(static_cast<u_short>(cvars::nb_remote_input_port));
+  addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+  if (bind(s, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)) != 0) {
+    XELOGE("nbremote: cannot bind 127.0.0.1:{}", cvars::nb_remote_input_port);
+    closesocket(s);
+    return X_STATUS_UNSUCCESSFUL;
+  }
+  socket_ = static_cast<uintptr_t>(s);
+  thread_ = std::thread([this] { Receive(); });
+  XELOGI("nbremote: remote gamepad listening on 127.0.0.1:{}",
+         cvars::nb_remote_input_port);
+  return X_STATUS_SUCCESS;
+}
+
+// One VK_PAD code per button (in X_INPUT_GAMEPAD_* bit order).
+static const std::pair<uint16_t, ui::VirtualKey> kButtonKeys[] = {
+    {0x0001, ui::VirtualKey::kXInputPadDpadUp},
+    {0x0002, ui::VirtualKey::kXInputPadDpadDown},
+    {0x0004, ui::VirtualKey::kXInputPadDpadLeft},
+    {0x0008, ui::VirtualKey::kXInputPadDpadRight},
+    {0x0010, ui::VirtualKey::kXInputPadStart},
+    {0x0020, ui::VirtualKey::kXInputPadBack},
+    {0x0040, ui::VirtualKey::kXInputPadLThumbPress},
+    {0x0080, ui::VirtualKey::kXInputPadRThumbPress},
+    {0x0100, ui::VirtualKey::kXInputPadLShoulder},
+    {0x0200, ui::VirtualKey::kXInputPadRShoulder},
+    {0x1000, ui::VirtualKey::kXInputPadA},
+    {0x2000, ui::VirtualKey::kXInputPadB},
+    {0x4000, ui::VirtualKey::kXInputPadX},
+    {0x8000, ui::VirtualKey::kXInputPadY},
+};
+
+void NbRemoteInputDriver::Receive() {
+  uint8_t buf[64];
+  while (!stop_) {
+    int n = recv(static_cast<SOCKET>(socket_), reinterpret_cast<char*>(buf),
+                 sizeof(buf), 0);
+    if (n < 0) {
+      if (stop_) break;
+      continue;
+    }
+    if (n < 18 || std::memcmp(buf, "NBPD", 4) != 0 || buf[4] > 3) continue;
+    auto i16 = [&](int o) {
+      return static_cast<int16_t>(buf[o] | (buf[o + 1] << 8));
+    };
+    std::lock_guard<std::mutex> lock(mutex_);
+    Pad& p = pads_[buf[4]];
+    uint16_t buttons = static_cast<uint16_t>(buf[8] | (buf[9] << 8));
+    p.connected = buf[5] != 0;
+    // keystrokes for button edges (menus that read XInputGetKeystroke)
+    uint16_t changed = static_cast<uint16_t>(buttons ^ p.buttons);
+    for (auto& [bit, vk] : kButtonKeys) {
+      if (!(changed & bit)) continue;
+      X_INPUT_KEYSTROKE k{};
+      k.virtual_key = static_cast<uint16_t>(vk);
+      k.flags = (buttons & bit) ? X_INPUT_KEYSTROKE_KEYDOWN
+                                : X_INPUT_KEYSTROKE_KEYUP;
+      k.user_index = buf[4];
+      if (p.keys.size() < 64) p.keys.push_back(k);
+    }
+    p.buttons = buttons;
+    // thumbstick directions as keystrokes too (XInputGetKeystroke reports
+    // VK_PAD_LTHUMB_* / RTHUMB_* for deflections past half range)
+    auto dir = [](int16_t x, int16_t y) {
+      const int t = 16384;
+      int h = x > t ? 1 : x < -t ? -1 : 0, v = y > t ? 1 : y < -t ? -1 : 0;
+      static const int8_t kDir[3][3] = {{7, 1, 4}, {3, -1, 2}, {6, 0, 5}};
+      return kDir[v + 1][h + 1];  // index: up, down, right, left, ul, ur, dr, dl
+    };
+    static const uint16_t kUp[2] = {0x5820, 0x5830};
+    for (int stick = 0; stick < 2; stick++) {
+      int16_t nx = i16(stick ? 14 : 10), ny = i16(stick ? 16 : 12);
+      int16_t ox = stick ? p.gamepad.thumb_rx : p.gamepad.thumb_lx;
+      int16_t oy = stick ? p.gamepad.thumb_ry : p.gamepad.thumb_ly;
+      int od = dir(ox, oy), nd = dir(nx, ny);
+      if (od == nd) continue;
+      if (od >= 0 && p.keys.size() < 64) {
+        X_INPUT_KEYSTROKE k{};
+        k.virtual_key = static_cast<uint16_t>(kUp[stick] + od);
+        k.flags = X_INPUT_KEYSTROKE_KEYUP; k.user_index = buf[4];
+        p.keys.push_back(k);
+      }
+      if (nd >= 0 && p.keys.size() < 64) {
+        X_INPUT_KEYSTROKE k{};
+        k.virtual_key = static_cast<uint16_t>(kUp[stick] + nd);
+        k.flags = X_INPUT_KEYSTROKE_KEYDOWN; k.user_index = buf[4];
+        p.keys.push_back(k);
+      }
+    }
+    p.gamepad.buttons = buttons;
+    p.gamepad.left_trigger = buf[6];
+    p.gamepad.right_trigger = buf[7];
+    p.gamepad.thumb_lx = i16(10);
+    p.gamepad.thumb_ly = i16(12);
+    p.gamepad.thumb_rx = i16(14);
+    p.gamepad.thumb_ry = i16(16);
+    p.packet++;
+  }
+}
+
+X_RESULT NbRemoteInputDriver::GetCapabilities(uint32_t user_index,
+                                              uint32_t flags,
+                                              X_INPUT_CAPABILITIES* out_caps) {
+  if (user_index > 3) return X_ERROR_DEVICE_NOT_CONNECTED;
+  std::lock_guard<std::mutex> lock(mutex_);
+  if (!pads_[user_index].connected) return X_ERROR_DEVICE_NOT_CONNECTED;
+  out_caps->type = X_INPUT_DEVTYPE::XINPUT_DEVTYPE_GAMEPAD;
+  out_caps->sub_type = X_INPUT_DEVSUBTYPE::XINPUT_DEVSUBTYPE_GAMEPAD;
+  out_caps->flags = 0;
+  out_caps->gamepad.buttons = 0xFFFF;
+  out_caps->gamepad.left_trigger = 0xFF;
+  out_caps->gamepad.right_trigger = 0xFF;
+  out_caps->gamepad.thumb_lx = (int16_t)0xFFFFu;
+  out_caps->gamepad.thumb_ly = (int16_t)0xFFFFu;
+  out_caps->gamepad.thumb_rx = (int16_t)0xFFFFu;
+  out_caps->gamepad.thumb_ry = (int16_t)0xFFFFu;
+  out_caps->vibration.left_motor_speed = 0;
+  out_caps->vibration.right_motor_speed = 0;
+  return X_ERROR_SUCCESS;
+}
+
+X_RESULT NbRemoteInputDriver::GetState(uint32_t user_index,
+                                       X_INPUT_STATE* out_state) {
+  if (user_index > 3) return X_ERROR_DEVICE_NOT_CONNECTED;
+  std::lock_guard<std::mutex> lock(mutex_);
+  const Pad& p = pads_[user_index];
+  if (!p.connected) return X_ERROR_DEVICE_NOT_CONNECTED;
+  out_state->packet_number = p.packet;
+  out_state->gamepad = p.gamepad;
+  return X_ERROR_SUCCESS;
+}
+
+X_RESULT NbRemoteInputDriver::SetState(uint32_t user_index,
+                                       X_INPUT_VIBRATION* vibration) {
+  if (user_index > 3) return X_ERROR_DEVICE_NOT_CONNECTED;
+  std::lock_guard<std::mutex> lock(mutex_);
+  return pads_[user_index].connected ? X_ERROR_SUCCESS
+                                     : X_ERROR_DEVICE_NOT_CONNECTED;
+}
+
+X_RESULT NbRemoteInputDriver::GetKeystroke(uint32_t user_index, uint32_t flags,
+                                           X_INPUT_KEYSTROKE* out_keystroke) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  // XUSER_INDEX_ANY (0xFF): any connected pad
+  for (uint32_t u = 0; u < 4; u++) {
+    if (user_index != 0xFF && user_index != u) continue;
+    Pad& p = pads_[u];
+    if (!p.connected) continue;
+    if (p.keys.empty()) return X_ERROR_EMPTY;
+    *out_keystroke = p.keys.front();
+    p.keys.pop_front();
+    return X_ERROR_SUCCESS;
+  }
+  return X_ERROR_DEVICE_NOT_CONNECTED;
+}
+
+std::unique_ptr<InputDriver> Create(xe::ui::Window* window,
+                                    size_t window_z_order) {
+  return std::make_unique<NbRemoteInputDriver>(window, window_z_order);
+}
+
+}  // namespace nbremote
+}  // namespace hid
+}  // namespace xe
