new file mode 100644
index 0000000..faef088
--- /dev/null
+++ b/src/xenia/hid/nbremote/nbremote_input_driver.h
@@ -0,0 +1,69 @@
+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * NB Studio remote gamepad: controller states for users 0-3 received as UDP  *
+ * packets on 127.0.0.1 (cvar nb_remote_input_port). Released under the BSD   *
+ * license - see LICENSE in the root for more details.                        *
+ ******************************************************************************
+ */
+
+#ifndef XENIA_HID_NBREMOTE_NBREMOTE_INPUT_DRIVER_H_
+#define XENIA_HID_NBREMOTE_NBREMOTE_INPUT_DRIVER_H_
+
+#include <atomic>
+#include <memory>
+#include <deque>
+#include <mutex>
+#include <thread>
+
+#include "xenia/hid/input_driver.h"
+
+namespace xe {
+namespace hid {
+namespace nbremote {
+
+// Packet (little endian, 18 bytes): "NBPD", u8 user, u8 connected, u8 lt,
+// u8 rt, u16 buttons (X_INPUT_GAMEPAD_*), i16 lx, ly, rx, ry.
+// connected = 0 unplugs the virtual pad for that user.
+class NbRemoteInputDriver final : public InputDriver {
+ public:
+  explicit NbRemoteInputDriver(xe::ui::Window* window, size_t window_z_order);
+  ~NbRemoteInputDriver() override;
+
+  X_STATUS Setup() override;
+
+  X_RESULT GetCapabilities(uint32_t user_index, uint32_t flags,
+                           X_INPUT_CAPABILITIES* out_caps) override;
+  X_RESULT GetState(uint32_t user_index, X_INPUT_STATE* out_state) override;
+  X_RESULT SetState(uint32_t user_index, X_INPUT_VIBRATION* vibration) override;
+  X_RESULT GetKeystroke(uint32_t user_index, uint32_t flags,
+                        X_INPUT_KEYSTROKE* out_keystroke) override;
+
+  InputType GetInputType() const override { return InputType::Controller; }
+
+ private:
+  struct Pad {
+    bool connected = false;
+    uint32_t packet = 0;
+    X_INPUT_GAMEPAD gamepad{};
+    uint16_t buttons = 0;  // host order copy for edge detection
+    std::deque<X_INPUT_KEYSTROKE> keys;
+  };
+  void Receive();
+
+  std::mutex mutex_;
+  Pad pads_[4];
+  std::thread thread_;
+  std::atomic<bool> stop_{false};
+  uintptr_t socket_ = ~uintptr_t(0);
+};
+
+std::unique_ptr<InputDriver> Create(xe::ui::Window* window,
+                                    size_t window_z_order);
+
+}  // namespace nbremote
+}  // namespace hid
+}  // namespace xe
+
+#endif  // XENIA_HID_NBREMOTE_NBREMOTE_INPUT_DRIVER_H_
