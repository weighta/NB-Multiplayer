+// ---------------------------------------------------------------- NB overlay
+
+
+bool XSocket::NbOverlayActive() const {
+  return nboverlay::Enabled() && proto_ == X_IPPROTO_UDP;
+}
+
+void XSocket::NbSendHello() {
+  sockaddr_in relay;
+  if (!nboverlay::RelayAddress(&relay)) return;
+  uint8_t header[nboverlay::kHeaderSize];
+  nboverlay::WriteHeader(header, nboverlay::kTypeHello, nboverlay::SelfVip(),
+                         bound_port_, 0, 0);
+  ::sendto(native_handle_, reinterpret_cast<char*>(header), sizeof(header), 0,
+           reinterpret_cast<sockaddr*>(&relay), sizeof(relay));
+  NbLog("send hello", bound_port_, nboverlay::SelfVip(), bound_port_, 0);
+}
+
+int XSocket::NbSendTo(const uint8_t* const* bufs, const uint32_t* lens,
+                      uint32_t n, uint32_t dst_ip, uint16_t dst_port) {
+  sockaddr_in relay;
+  if (!nboverlay::RelayAddress(&relay)) {
+    XWSASetLastError(X_WSA_ERROR::X_WSAEHOSTUNREACH);
+    return X_SOCKET_ERROR;
+  }
+  size_t total = 0;
+  for (uint32_t i = 0; i < n; i++) total += lens[i];
+  // an association address stands for (peer vip, session key)
+  uint32_t dst_vip = dst_ip;
+  uint64_t key = 0;
+  if (!nboverlay::AssocResolve(dst_ip, &dst_vip, &key)) {
+    XWSASetLastError(X_WSA_ERROR::X_WSAEHOSTUNREACH);
+    return X_SOCKET_ERROR;
+  }
+  std::vector<uint8_t> pkt(nboverlay::kDataHeaderSize + total);
+  if (!bound_port_) {
+    // first send on an unbound socket: bind like the game would implicitly
+    sockaddr_in any{};
+    any.sin_family = AF_INET;
+    bind(native_handle_, reinterpret_cast<sockaddr*>(&any), sizeof(any));
+    bound_port_ = GetImplicitlyBoundPort();
+    bound_ = true;
+  }
+  nboverlay::WriteHeader(pkt.data(), nboverlay::kTypeData,
+                         nboverlay::SelfVip(), bound_port_, dst_vip, dst_port,
+                         key);
+  size_t o = nboverlay::kDataHeaderSize;
+  for (uint32_t i = 0; i < n; i++) {
+    std::memcpy(pkt.data() + o, bufs[i], lens[i]);
+    o += lens[i];
+  }
+  int ret = ::sendto(native_handle_, reinterpret_cast<char*>(pkt.data()),
+                     static_cast<int>(pkt.size()), 0,
+                     reinterpret_cast<sockaddr*>(&relay), sizeof(relay));
+  NbLog(ret < 0 ? "send FAILED" : "send", bound_port_, dst_ip, dst_port, total);
+  return ret < 0 ? ret : static_cast<int>(total);
+}
+
+int XSocket::NbRecvFrom(uint8_t* buf, uint32_t buf_len, int flags,
+                        sockaddr_in* from) {
+  std::vector<uint8_t> tmp(buf_len + nboverlay::kDataHeaderSize);
+  while (true) {
+    sockaddr_in src{};
+    socklen_t src_len = sizeof(src);
+    int n = ::recvfrom(native_handle_, reinterpret_cast<char*>(tmp.data()),
+                       static_cast<int>(tmp.size()), flags,
+                       reinterpret_cast<sockaddr*>(&src), &src_len);
+    if (n < 0) return n;
+    const bool relayed = nboverlay::IsFromRelay(reinterpret_cast<sockaddr*>(&src));
+    uint32_t vip = 0;
+    uint16_t vport = 0;
+    uint64_t key = 0;
+    if (relayed) {
+      if (!nboverlay::ReadHeader(tmp.data(), n, &vip, &vport, &key)) continue;  // relay control
+      const int payload = n - static_cast<int>(nboverlay::kDataHeaderSize);
+      std::memcpy(buf, tmp.data() + nboverlay::kDataHeaderSize,
+                  std::min<uint32_t>(payload, buf_len));
+      from->sin_family = AF_INET;
+      from->sin_addr.s_addr = htonl(nboverlay::AssocAddress(vip, key));
+      from->sin_port = htons(vport);
+      NbLog("recv", bound_port_, vip, vport, payload);
+      return std::min<int>(payload, static_cast<int>(buf_len));
+    }
+    std::memcpy(buf, tmp.data(), std::min<uint32_t>(n, buf_len));
+    *from = src;
+    return std::min<int>(n, static_cast<int>(buf_len));
+  }
+}
+
 }  // namespace kernel
 }  // namespace xe
