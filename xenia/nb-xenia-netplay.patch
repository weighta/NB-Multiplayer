 }
 
+
+// NB Studio test instances: create (and sign in to slot 0) a profile when
+// there is none yet, so every instance gets its own XUID. Called by the
+// emulator once the kernel is fully set up.
+void ProfileManager::NbEnsureProfile() {
+  if (cvars::nb_create_profile.empty()) return;
+  if (!accounts_.empty()) {
+    // later runs: sign in the existing profile unless one is signed in already
+    if (!IsAnyProfileSignedIn()) Login(accounts_.begin()->first, 0);
+    return;
+  }
+  uint64_t xuid = 0;
+  // Live-enabled (the game's Xbox LIVE multiplayer only accepts such profiles)
+  if (!CreateProfile(cvars::nb_create_profile, false, false,
+                     X_XAMACCOUNTINFO::AccountReservedFlags::kLiveEnabled,
+                     &xuid)) {
+    XELOGE("NB: creating profile {} failed", cvars::nb_create_profile);
+    return;
+  }
+  XELOGI("NB: created profile {} ({:016X})", cvars::nb_create_profile, xuid);
+  Login(xuid, 0);
+}
+
 }  // namespace xam
 }  // namespace kernel
 }  // namespace xe
