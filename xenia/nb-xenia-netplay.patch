+
+DEFINE_bool(nb_overlay, false,
+            "NB multiplayer: route game traffic to virtual addresses "
+            "(10.77.0.N) through the room relay.",
+            "Live");
+DEFINE_int32(nb_instance, 1,
+             "NB multiplayer: instance number sent to the room server "
+             "(distinguishes several instances on one PC).",
+             "Live");
+DEFINE_string(nb_relay, "",
+              "NB multiplayer: relay host:port (default: api_address host, "
+              "port 36001).",
+              "Live");
+DEFINE_int32(nb_control_port, 0,
+             "NB multiplayer: UDP port on 127.0.0.1 for NB Studio commands "
+             "(JOIN <xuid>); 0 = off.",
+             "Live");
+DEFINE_bool(nb_auto_join, true,
+            "NB multiplayer: when this player opens Xbox LIVE, join the room "
+            "host's party automatically.",
+            "Live");
+DEFINE_string(nb_room_code, "",
+              "NB multiplayer: room code shown in the on-screen notices.",
+              "Live");
+DEFINE_bool(nb_room_matchmaking, true,
+            "NB multiplayer: Nuts & Bolts Ranked/Player Match lobbies start "
+            "with 2 or more players after 20 s (the game waits for 4 of 8 "
+            "players and 40 s).",
+            "Live");
+DECLARE_string(api_address);
+
+namespace xe {
+namespace kernel {
+namespace nboverlay {
+
+bool Enabled() { return cvars::nb_overlay; }
+
+std::string InstanceHeader() {
+  return "X-NB-Instance: " + std::to_string(cvars::nb_instance);
+}
+
+bool IsOverlayAddress(uint32_t ip) {
+  return (ip & 0xFFFF0000u) == 0x0A4D0000u || IsAssocAddress(ip) ||
+         ip == 0xFFFFFFFFu;
+}
+
+bool IsAssocAddress(uint32_t ip) { return (ip & 0xFFFF0000u) == 0x0A4E0000u; }
+
+namespace {
+struct Assoc {
+  uint32_t vip;
+  uint64_t key;
+};
+std::mutex assoc_mutex;
+std::vector<Assoc> assocs;  // index i -> 10.78.0.0 + i + 1
+}  // namespace
+
+uint32_t AssocAddress(uint32_t vip, uint64_t key) {
+  if (!key || IsAssocAddress(vip)) return vip;
+  std::lock_guard<std::mutex> lock(assoc_mutex);
+  for (size_t i = 0; i < assocs.size(); i++)
+    if (assocs[i].vip == vip && assocs[i].key == key)
+      return 0x0A4E0000u + static_cast<uint32_t>(i + 1);
+  if (assocs.size() >= 0xFFFE) return vip;
+  assocs.push_back({vip, key});
+  const uint32_t ip = 0x0A4E0000u + static_cast<uint32_t>(assocs.size());
+  XELOGI("nboverlay: association {}.{}.{}.{} = peer {}.{}.{}.{} key {:016X}",
+         ip >> 24, (ip >> 16) & 255, (ip >> 8) & 255, ip & 255, vip >> 24,
+         (vip >> 16) & 255, (vip >> 8) & 255, vip & 255, key);
+  return ip;
+}
+
+bool AssocResolve(uint32_t ip, uint32_t* vip, uint64_t* key) {
+  if (IsAssocAddress(ip)) {
+    std::lock_guard<std::mutex> lock(assoc_mutex);
+    const uint32_t i = (ip & 0xFFFFu) - 1;
+    if (i >= assocs.size()) return false;
+    *vip = assocs[i].vip;
+    *key = assocs[i].key;
+    return true;
+  }
+  *vip = ip;
+  *key = 0;
+  return true;
+}
+
+uint32_t SelfVip() {
+  auto* api = kernel_state() ? kernel_state()->GetXboxLiveAPI() : nullptr;
+  if (!api) return 0;
+  uint32_t ip = ntohl(api->OnlineIP().sin_addr.s_addr);
+  return (ip & 0xFFFF0000u) == 0x0A4D0000u ? ip : 0;
+}
+
+bool RelayAddress(sockaddr_in* out) {
+  static std::mutex mutex;
+  static sockaddr_in cached{};
+  static bool resolved = false;
+  std::lock_guard<std::mutex> lock(mutex);
+  if (!resolved) {
+    std::string spec = cvars::nb_relay;
+    std::string host;
+    uint16_t port = 36001;
+    if (spec.empty()) {
+      // api_address like "http://1.2.3.4:36000/" or "1.2.3.4:36000/"
+      spec = cvars::api_address;
+      auto scheme = spec.find("://");
+      if (scheme != std::string::npos) spec = spec.substr(scheme + 3);
+      auto slash = spec.find('/');
+      if (slash != std::string::npos) spec = spec.substr(0, slash);
+      auto colon = spec.rfind(':');
+      host = colon == std::string::npos ? spec : spec.substr(0, colon);
+    } else {
+      auto colon = spec.rfind(':');
+      host = colon == std::string::npos ? spec : spec.substr(0, colon);
+      if (colon != std::string::npos)
+        port = static_cast<uint16_t>(std::stoi(spec.substr(colon + 1)));
+    }
+    addrinfo hints{}, *res = nullptr;
+    hints.ai_family = AF_INET;
+    hints.ai_socktype = SOCK_DGRAM;
+    if (getaddrinfo(host.c_str(), nullptr, &hints, &res) != 0 || !res) {
+      XELOGE("nboverlay: cannot resolve relay host '{}'", host);
+      return false;
+    }
+    cached = *reinterpret_cast<sockaddr_in*>(res->ai_addr);
+    cached.sin_port = htons(port);
+    freeaddrinfo(res);
+    resolved = true;
+    char text[32];
+    inet_ntop(AF_INET, &cached.sin_addr, text, sizeof(text));
+    XELOGI("nboverlay: relay {}:{}", text, port);
+  }
+  *out = cached;
+  return true;
+}
+
+bool IsFromRelay(const sockaddr* from) {
+  if (!from || from->sa_family != AF_INET) return false;
+  sockaddr_in relay;
+  if (!RelayAddress(&relay)) return false;
+  auto* in = reinterpret_cast<const sockaddr_in*>(from);
+  return in->sin_port == relay.sin_port &&
+         (in->sin_addr.s_addr == relay.sin_addr.s_addr ||
+          // a relay on this PC may answer from any local address
+          ntohl(relay.sin_addr.s_addr) >> 24 == 127);
+}
+
+static void Put32(uint8_t* p, uint32_t v) {
+  p[0] = uint8_t(v >> 24); p[1] = uint8_t(v >> 16); p[2] = uint8_t(v >> 8); p[3] = uint8_t(v);
+}
+static void Put16(uint8_t* p, uint16_t v) { p[0] = uint8_t(v >> 8); p[1] = uint8_t(v); }
+static uint32_t Get32(const uint8_t* p) {
+  return uint32_t(p[0]) << 24 | uint32_t(p[1]) << 16 | uint32_t(p[2]) << 8 | p[3];
+}
+static uint16_t Get16(const uint8_t* p) { return uint16_t(p[0] << 8 | p[1]); }
+
+void WriteHeader(uint8_t* out, uint8_t type, uint32_t src_vip,
+                 uint16_t src_port, uint32_t dst_vip, uint16_t dst_port,
+                 uint64_t key) {
+  out[0] = 'N'; out[1] = 'B'; out[2] = type; out[3] = 0;
+  Put32(out + 4, src_vip); Put16(out + 8, src_port);
+  Put32(out + 10, dst_vip); Put16(out + 14, dst_port);
+  if (type == kTypeData) {
+    Put32(out + 16, uint32_t(key >> 32));
+    Put32(out + 20, uint32_t(key));
+  }
+}
+
+bool ReadHeader(const uint8_t* in, size_t len, uint32_t* src_vip,
+                uint16_t* src_port, uint64_t* key) {
+  if (len < kDataHeaderSize || in[0] != 'N' || in[1] != 'B' ||
+      in[2] != kTypeData)
+    return false;
+  *src_vip = Get32(in + 4);
+  *src_port = Get16(in + 8);
+  *key = uint64_t(Get32(in + 16)) << 32 | Get32(in + 20);
+  return true;
+}
+
+
+std::string JoinSession(uint64_t inviter) {
+  auto* ks = kernel_state();
+  if (!ks || !ks->title_id()) return "ERR no title running";
+  auto* profile = ks->xam_state()->GetUserProfile(0u);
+  if (!profile) return "ERR no profile signed in (user 0)";
+  X_INVITE_INFO invite = {};
+  invite.xuid_invitee = profile->GetOnlineXUID();
+  invite.xuid_inviter = inviter;
+  invite.title_id = ks->title_id();
+  invite.from_game_invite = true;
+  // The game only stays in a private party match with Xbox LIVE friends: make
+  // the host a friend first (as an accepted friend request would).
+  const bool added = ks->xam_state()->friends_manager()->AddFriend(
+      profile->xuid(), inviter, true);
+  XELOGI("nboverlay: {:016X} {} friends list", inviter,
+         added ? "added to the" : "already on the");
+  profile->SetSelfInvite(invite);
+  ks->BroadcastNotification(kXNotificationLiveInviteAccepted, 0);
+  XELOGI("nboverlay: joining the session of {:016X} (invite accepted)", inviter);
+  return "OK joining";
+}
+
+// ------------------------------------------------------------- room watch
+
+namespace {
+std::atomic<bool> lobby_created{false};
+
+size_t CurlWrite(char* data, size_t size, size_t n, void* out) {
+  static_cast<std::string*>(out)->append(data, size * n);
+  return size * n;
+}
+
+std::string HttpGet(const std::string& url) {
+  std::string body;
+  CURL* curl = curl_easy_init();
+  if (!curl) return body;
+  curl_slist* headers = curl_slist_append(nullptr, InstanceHeader().c_str());
+  curl_easy_setopt(curl, CURLOPT_URL, url.c_str());
+  curl_easy_setopt(curl, CURLOPT_HTTPHEADER, headers);
+  curl_easy_setopt(curl, CURLOPT_TIMEOUT, 4L);
+  curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, CurlWrite);
+  curl_easy_setopt(curl, CURLOPT_WRITEDATA, &body);
+  long code = 0;
+  if (curl_easy_perform(curl) != CURLE_OK ||
+      curl_easy_getinfo(curl, CURLINFO_RESPONSE_CODE, &code) != CURLE_OK ||
+      code != 200)
+    body.clear();
+  curl_slist_free_all(headers);
+  curl_easy_cleanup(curl);
+  return body;
+}
+
+void Notify(const std::string& title, const std::string& text) {
+  XELOGI("nboverlay: notice: {} - {}", title, text);
+  auto* ks = kernel_state();
+  if (!ks || !ks->emulator() || !ks->emulator()->imgui_drawer()) return;
+  new xe::ui::HostNotificationWindow(ks->emulator()->imgui_drawer(), title,
+                                     text, 0);
+}
+}  // namespace
+
+void OnLobbyCreated() {
+  if (Enabled()) lobby_created = true;
+}
+
+std::string JoinSession(uint64_t inviter);
+
+// Polls the room server's /nb/room: befriends every player in the room (the
+// game only joins and keeps parties of Xbox LIVE friends), shows who is in the
+// room, and - for players other than the host - joins the host's party once
+// this player's own Xbox LIVE lobby exists and the host is in a session.
+static void StartRoomWatch() {
+  static bool started = false;
+  if (started || !Enabled()) return;
+  started = true;
+  std::thread([] {
+    std::set<uint64_t> known;
+    bool announced = false;
+    while (true) {
+      std::this_thread::sleep_for(std::chrono::seconds(3));
+      auto* ks = kernel_state();
+      auto* profile = ks ? ks->xam_state()->GetUserProfile(0u) : nullptr;
+      if (!profile || !ks->GetXboxLiveAPI()) continue;
+      const std::string body =
+          HttpGet(XLiveAPI::GetApiAddress() + "nb/room");
+      rapidjson::Document doc;
+      if (body.empty() || doc.Parse(body.c_str()).HasParseError() ||
+          !doc.IsObject())
+        continue;
+      const uint64_t self = profile->GetOnlineXUID();
+      const uint64_t host =
+          doc.HasMember("host") && doc["host"].IsString()
+              ? std::strtoull(doc["host"].GetString(), nullptr, 16)
+              : 0;
+      std::string host_name = "the host";
+      bool host_in_session = false;
+      if (doc.HasMember("players") && doc["players"].IsArray()) {
+        for (auto& p : doc["players"].GetArray()) {
+          if (!p.IsObject() || !p.HasMember("xuid") || !p["xuid"].IsString())
+            continue;
+          const uint64_t xuid = std::strtoull(p["xuid"].GetString(), nullptr, 16);
+          const std::string name = p.HasMember("gamertag") && p["gamertag"].IsString()
+                                       ? p["gamertag"].GetString()
+                                       : "a player";
+          if (xuid == host) {
+            host_name = name;
+            host_in_session = p.HasMember("session") && p["session"].IsString() &&
+                              std::strtoull(p["session"].GetString(), nullptr, 16) != 0;
+          }
+          if (!xuid || xuid == self || known.count(xuid)) continue;
+          known.insert(xuid);
+          const bool added = ks->xam_state()->friends_manager()->AddFriend(
+              profile->xuid(), xuid, true);
+          XELOGI("nboverlay: room player {:016X} {} ({})", xuid, name,
+                 added ? "added as friend" : "already a friend");
+          if (announced) Notify("NB multiplayer", name + " is in the room");
+        }
+      }
+      if (!announced && host) {
+        announced = true;
+        const std::string code = cvars::nb_room_code.empty()
+                                     ? std::string()
+                                     : " " + cvars::nb_room_code;
+        if (host == self)
+          Notify("NB multiplayer",
+                 "Hosting game with code:" + code + " (" +
+                     std::to_string(known.size() + 1) + " in the room)");
+        else
+          Notify("NB multiplayer", "Connected to " + host_name +
+                                       "'s room" + code +
+                                       ". Open Multiplayer > Xbox LIVE to join.");
+      }
+      if (host && host != self && cvars::nb_auto_join && host_in_session &&
+          lobby_created.exchange(false)) {
+        std::this_thread::sleep_for(std::chrono::seconds(4));
+        XELOGI("nboverlay: auto-join: {}", JoinSession(host));
+        Notify("NB multiplayer", "Joining " + host_name + "'s party");
+      }
+    }
+  }).detach();
+}
+
+void StartControl() {
+  StartRoomWatch();
+  if (cvars::nb_control_port <= 0) return;
+  static bool started = false;
+  if (started) return;
+  started = true;
+  std::thread([] {
+    SOCKET s = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+    sockaddr_in addr{};
+    addr.sin_family = AF_INET;
+    addr.sin_port = htons(static_cast<u_short>(cvars::nb_control_port));
+    addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    if (bind(s, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)) != 0) {
+      XELOGE("nboverlay: cannot bind control port {}", cvars::nb_control_port);
+      return;
+    }
+    XELOGI("nboverlay: control port 127.0.0.1:{}", cvars::nb_control_port);
+    char buf[256];
+    while (true) {
+      sockaddr_in from{};
+      int from_len = sizeof(from);
+      int n = recvfrom(s, buf, sizeof(buf) - 1, 0,
+                       reinterpret_cast<sockaddr*>(&from), &from_len);
+      if (n <= 0) continue;
+      buf[n] = 0;
+      std::string cmd(buf), reply = "ERR unknown command";
+      if (cmd.rfind("JOIN ", 0) == 0) {
+        uint64_t xuid = std::strtoull(cmd.c_str() + 5, nullptr, 16);
+        reply = xuid ? JoinSession(xuid) : "ERR bad xuid";
+      } else if (cmd.rfind("FRIEND ", 0) == 0) {
+        uint64_t xuid = std::strtoull(cmd.c_str() + 7, nullptr, 16);
+        auto* ks = kernel_state();
+        auto* profile = ks ? ks->xam_state()->GetUserProfile(0u) : nullptr;
+        if (!xuid || !profile) {
+          reply = "ERR bad xuid or no profile";
+        } else {
+          bool added = ks->xam_state()->friends_manager()->AddFriend(
+              profile->xuid(), xuid, true);
+          reply = added ? "OK friend added" : "OK already a friend";
+        }
+      } else if (cmd.rfind("PING", 0) == 0) {
+        reply = "OK " + std::to_string(cvars::nb_instance);
+      }
+      sendto(s, reply.c_str(), static_cast<int>(reply.size()), 0,
+             reinterpret_cast<sockaddr*>(&from), from_len);
+    }
+  }).detach();
+}
+
+void ApplyTitleFixes(Memory* memory, uint32_t title_id) {
+  if (!Enabled() || !memory) return;
+  struct Word {
+    uint32_t address, original, patched;
+    const char* what;
+  };
+  // Banjo-Kazooie: Nuts & Bolts, auto-matchmaking STATE_WAITING_FOR_OTHERS
+  // (0x824FA280): the session owner starts the match when the players still
+  // missing (8 slots - players) are <= an allowance that is 0, then 2 after
+  // T = 40 s, then 4 after T + 15 s; at T + 30 s it gives up and searches
+  // again. A room of 2-3 friends never got a match. Same words as NB.Core
+  // ExePatches "small-room-matchmaking".
+  static const Word kNutsAndBoltsMatchmaking[] = {
+      {0x824F406C, 0x616B9C40, 0x616B4E20,
+       "T = 20 s (was 40 s) on entering STATE_WAITING_FOR_OTHERS"},
+      {0x824FA4F8, 0x3BA00002, 0x3BA00006,
+       "allowance after T: 6 missing (2 players of 8) instead of 2"},
+      {0x824FA434, 0x3BA00004, 0x3BA00006,
+       "allowance after T + 15 s: 6 missing instead of 4"},
+  };
+  if (title_id != 0x4D5307ED || !cvars::nb_room_matchmaking) return;
+  for (const Word& w : kNutsAndBoltsMatchmaking) {
+    uint8_t* p = memory->TranslateVirtual(w.address);
+    if (!p || xe::load_and_swap<uint32_t>(p) != w.original) {
+      XELOGW("nboverlay: matchmaking fix skipped: {:08X} is not {:08X}",
+             w.address, w.original);
+      return;   // another build or mod: change nothing
+    }
+  }
+  for (const Word& w : kNutsAndBoltsMatchmaking) {
+    xe::BaseHeap* heap = memory->LookupHeap(w.address);
+    if (!heap) continue;
+    uint32_t old_protect = 0;
+    heap->QueryProtect(w.address, &old_protect);
+    heap->Protect(w.address, 4, kMemoryProtectRead | kMemoryProtectWrite);
+    xe::store_and_swap<uint32_t>(memory->TranslateVirtual(w.address),
+                                 w.patched);
+    heap->Protect(w.address, 4, old_protect);
+  }
+  XELOGI("nboverlay: small-room matchmaking on (2+ players start after 20 s)");
+}
+
+}  // namespace nboverlay
+}  // namespace kernel
+}  // namespace xe
diff --git a/src/xenia/kernel/nb_overlay.h b/src/xenia/kernel/nb_overlay.h
new file mode 100644
index 0000000..0429113
--- /dev/null
+++ b/src/xenia/kernel/nb_overlay.h
@@ -0,0 +1,102 @@
+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * NB multiplayer overlay network. Released under the BSD license - see       *
+ * LICENSE in the root for more details.                                      *
+ ******************************************************************************
+ *
+ * Every instance in an NB multiplayer room has a virtual IPv4 address
+ * 10.77.0.N, handed out by the room server (its /whoami answer, keyed by the
+ * X-NB-Instance header). Game UDP traffic addressed to a virtual address (or
+ * a broadcast) is not sent to the internet directly but wrapped in a 16-byte
+ * header and sent to the room's relay on the host, which forwards it to the
+ * right instance and socket. Only the host has to be reachable; clients behind
+ * NAT keep their mapping open by sending. Several instances can share one PC.
+ *
+ * Wire header (big endian): 'N' 'B' u8 type u8 0, u32 src_vip, u16 src_port,
+ * u32 dst_vip, u16 dst_port; data packets add u64 session key (XNKID), then
+ * the game payload. type 0 = hello (16 bytes, registers the sending socket for
+ * src_vip:src_port), type 1 = data (24-byte header).
+ *
+ * Security associations: on a console XNetXnAddrToInAddr hands out a separate
+ * IN_ADDR for every (peer, session key) pair, and XNetInAddrToXnAddr returns
+ * that pair's key. Titles that keep a peer in two sessions at once (Nuts &
+ * Bolts: party lobby + match) tell traffic apart by that address. With the
+ * overlay each pair gets a synthetic address 10.78.x.y; the key travels in the
+ * data header so the receiver reports the sender as its own address for the
+ * same pair.
+ */
+
+#ifndef XENIA_KERNEL_NB_OVERLAY_H_
+#define XENIA_KERNEL_NB_OVERLAY_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+
+#include "xenia/base/platform.h"
+#if XE_PLATFORM_WIN32
+#include <WS2tcpip.h>
+#include <WinSock2.h>
+#else
+#include <netinet/in.h>
+#include <sys/socket.h>
+#endif
+
+namespace xe {
+class Memory;
+namespace kernel {
+namespace nboverlay {
+
+constexpr size_t kHeaderSize = 16;      // hello
+constexpr size_t kDataHeaderSize = 24;  // data: + u64 session key
+constexpr uint8_t kTypeHello = 0;
+constexpr uint8_t kTypeData = 1;
+
+// cvar nb_overlay.
+bool Enabled();
+// "X-NB-Instance: <n>" (cvar nb_instance).
+std::string InstanceHeader();
+// 10.77.0.0/16, 10.78.0.0/16 (associations) or broadcast (host byte order).
+bool IsOverlayAddress(uint32_t ip);
+// Address of the (vip, key) association, created on first use; key 0 = vip.
+uint32_t AssocAddress(uint32_t vip, uint64_t key);
+// Peer vip and key behind an overlay address (a plain vip has key 0).
+bool AssocResolve(uint32_t ip, uint32_t* vip, uint64_t* key);
+bool IsAssocAddress(uint32_t ip);
+// This instance's virtual address (host order), 0 until known.
+uint32_t SelfVip();
+// Relay endpoint (cvar nb_relay, default: api_address host, port 36001).
+bool RelayAddress(sockaddr_in* out);
+bool IsFromRelay(const sockaddr* from);
+
+// Writes kHeaderSize bytes (hello) or kDataHeaderSize bytes (data).
+void WriteHeader(uint8_t* out, uint8_t type, uint32_t src_vip,
+                 uint16_t src_port, uint32_t dst_vip, uint16_t dst_port,
+                 uint64_t key = 0);
+// True for a relay data packet; fills the sender and the session key.
+bool ReadHeader(const uint8_t* in, size_t len, uint32_t* src_vip,
+                uint16_t* src_port, uint64_t* key);
+
+// Control port (cvar nb_control_port, 127.0.0.1 UDP): text commands from NB
+// Studio. "JOIN <host online xuid hex>" joins that player's party/session as
+// if an Xbox LIVE invite from them was accepted (user 0). Replies "OK ..." or
+// "ERR ..." to the sender.
+// Also starts the room watch (befriend room players, auto-join the host's
+// party: cvars nb_auto_join, nb_room_code).
+void StartControl();
+// Called when this console creates an Xbox LIVE group lobby (party) session.
+void OnLobbyCreated();
+
+// Called after a title module is loaded and its patch files are applied
+// (before it is precompiled). In NB rooms (nb_overlay) it applies game fixes
+// for room play, e.g. small-room matchmaking for Banjo-Kazooie: Nuts & Bolts
+// (cvar nb_room_matchmaking). Every word is checked against the original.
+void ApplyTitleFixes(Memory* memory, uint32_t title_id);
+
+}  // namespace nboverlay
+}  // namespace kernel
+}  // namespace xe
+
+#endif  // XENIA_KERNEL_NB_OVERLAY_H_
